# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a unique secret for each deployment
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: comma-separated administrator email addresses
ADMIN_EMAILS="admin@example.com"

# Public base URL, including https://, used in password reset links
APP_BASE_URL="https://example.com"

# Resend email API (verified sender domain required for production)
RESEND_API_KEY="re_replace-me"
RESEND_FROM_EMAIL="كتاب بكتاب <accounts@example.com>"
